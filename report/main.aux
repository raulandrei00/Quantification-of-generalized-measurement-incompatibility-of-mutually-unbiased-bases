\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Examples of compatibility hypergraphs on $n = 4$ measurements, reproduced from Fig.\nobreakspace  {}1 of Quintino \emph  {et al.}\nobreakspace  {}\cite  {Quintino2019}. Each node represents a complete measurement (a POVM); each hyperedge, drawn as a coloured region, groups measurements that are required to be jointly measurable. Vertices not contained in any hyperedge are incompatible with the rest. From left to right: $\mathcal  {C}_A = [(1,2)]$, $\mathcal  {C}_B = [(1,2),(3,4)]$, $\mathcal  {C}_C = [(1,2),(1,3),(2,4),(3,4)]$, $\mathcal  {C}_D = [(1,2,3),(2,4)]$.}}{6}{figure.1}\protected@file@percent }
\newlabel{fig:hypergraphs}{{1}{6}{Examples of compatibility hypergraphs on $n = 4$ measurements, reproduced from Fig.~1 of Quintino \emph {et al.}~\cite {Quintino2019}. Each node represents a complete measurement (a POVM); each hyperedge, drawn as a coloured region, groups measurements that are required to be jointly measurable. Vertices not contained in any hyperedge are incompatible with the rest. From left to right: $\mathcal {C}_A = [(1,2)]$, $\mathcal {C}_B = [(1,2),(3,4)]$, $\mathcal {C}_C = [(1,2),(1,3),(2,4),(3,4)]$, $\mathcal {C}_D = [(1,2,3),(2,4)]$}{figure.1}{}}
